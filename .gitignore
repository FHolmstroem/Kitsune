# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# Virtual environment
venv/
.venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Distribution
*.spec

# --- PyInstaller ---
# PyInstaller creates these folders to do its work and store the .exe
build/
dist/
# PyInstaller generates a .spec file. If you heavily customize it, you might 
# want to commit it later, but default ones should be ignored.
*.spec

# --- Inno Setup ---
# By default, Inno Setup spits the final installer into an 'Output' folder
Output/
*.tmp

# --- Python & OS specific (just in case you missed them) ---
__pycache__/
*.py[cod]
.pytest_cache/
venv/
.DS_Store
Thumbs.db

# --- PyInstaller ---
# Ignore the build folders and all spec files (case-insensitive)
build/
dist/
*.spec

# --- Inno Setup ---
# Ignore the generated setup executables, but KEEP the .iss script!
build_installer/
!build_installer/*.iss  
# (The line above says: ignore the folder, but specifically DO NOT ignore .iss files inside it)

# Alternatively, if you only put .exe files in build_installer, you can just do:
# build_installer/*.exe